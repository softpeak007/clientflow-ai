{
  "entities": {
    "User": {
      "title": "User",
      "description": "System users (freelancers and clients)",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "role": { "type": "string", "enum": ["admin", "client"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "role"]
    },
    "Client": {
      "title": "Client",
      "description": "Client profile managed by the freelancer",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "company": { "type": "string" },
        "adminId": { "type": "string" },
        "avatarUrl": { "type": "string" }
      },
      "required": ["id", "name", "email", "adminId"]
    },
    "Project": {
      "title": "Project",
      "description": "Work projects for clients",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "clientId": { "type": "string" },
        "adminId": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "status": { "type": "string", "enum": ["active", "completed", "on-hold"] },
        "deadline": { "type": "string", "format": "date-time" },
        "progress": { "type": "number" }
      },
      "required": ["id", "clientId", "adminId", "name", "status"]
    },
    "Invoice": {
      "title": "Invoice",
      "description": "Billing documents",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "clientId": { "type": "string" },
        "projectId": { "type": "string" },
        "amount": { "type": "number" },
        "currency": { "type": "string" },
        "status": { "type": "string", "enum": ["draft", "sent", "paid", "overdue"] },
        "dueDate": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "clientId", "amount", "status", "dueDate"]
    },
    "File": {
      "title": "File",
      "description": "Metadata for uploaded files",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "projectId": { "type": "string" },
        "clientId": { "type": "string" },
        "name": { "type": "string" },
        "url": { "type": "string" },
        "size": { "type": "number" },
        "type": { "type": "string" },
        "uploadedById": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "projectId", "name", "url", "uploadedById"]
    },
    "Message": {
      "title": "Message",
      "description": "Chat messages",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "projectId": { "type": "string" },
        "senderId": { "type": "string" },
        "senderName": { "type": "string" },
        "content": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "projectId", "senderId", "content", "createdAt"]
    },
    "Notification": {
      "title": "Notification",
      "description": "App notifications for users",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
         "title": { "type": "string" },
        "message": { "type": "string" },
        "read": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "message", "read", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "Global user profiles"
    },
    "/clients/{clientId}": {
      "schema": "Client",
      "description": "Clients managed by admin"
    },
    "/projects/{projectId}": {
      "schema": "Project",
      "description": "Major projects work"
    },
    "/projects/{projectId}/invoices/{invoiceId}": {
      "schema": "Invoice",
      "description": "Invoices tied to a project"
    },
    "/projects/{projectId}/files/{fileId}": {
      "schema": "File",
      "description": "Files uploaded to a project"
    },
    "/projects/{projectId}/messages/{messageId}": {
      "schema": "Message",
      "description": "Conversation thread per project"
    },
    "/users/{userId}/notifications/{notificationId}": {
      "schema": "Notification",
      "description": "User specific notifications"
    }
  }
}
